# Copy to .env and adjust. The server reads these from the environment;
# run.sh sources this file if present.

# Bind host/port. 0.0.0.0 so the laptop is reachable at its Tailscale hostname.
CMUX_SERVER_HOST=0.0.0.0
CMUX_SERVER_PORT=8765

# Absolute path to the cmux CLI. Leave blank to resolve via PATH.
# Find it with:  which cmux   (run inside a cmux pane)
CMUX_BIN=

# How often (seconds) the background loop checks for new notifications.
CMUX_POLL_INTERVAL=3

# Optional Telegram push. Leave blank to disable (server still runs fine).
# Reuse the bot you already run for Hermes, or make a new one via @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
